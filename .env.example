# PostgreSQL (Docker Compose local development)
POSTGRES_USER=pulsetrace
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_DB=pulsetrace
# Use 5433 if another PostgreSQL install already binds 5432 on the host (common on Windows).
POSTGRES_PORT=5433

# Backend — SQLAlchemy connection URL (host/port must match POSTGRES_PORT above)
DATABASE_URL=postgresql+psycopg://pulsetrace:change_me_in_local_env@localhost:5433/pulsetrace

# Application
APP_NAME=PulseTrace
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Authentication (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_COOKIE_NAME=pulsetrace_access_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Log ingestion / storage
LOG_UPLOAD_MAX_BYTES=10485760
LOG_STORAGE_PATH=../data/uploads
LOG_INSERT_BATCH_SIZE=500

# Analysis / anomaly detection (CPU-friendly; no GPU required)
ANALYSIS_WINDOW_HOURS=24
ANALYSIS_BUCKET_MINUTES=60
ANALYSIS_MIN_SAMPLES=5
ANALYSIS_ZSCORE_THRESHOLD=2.5
ANALYSIS_IF_CONTAMINATION=0.1
ANALYSIS_IF_MIN_ROWS=8
ANALYSIS_MAX_LOGS=20000
CLUSTER_MAX_LOGS=5000
CLUSTER_DBSCAN_EPS=0.35
CLUSTER_MIN_SAMPLES=3
CLUSTER_MAX_CLUSTERS=50
ANALYSIS_RANDOM_SEED=42

# Incident correlation
INCIDENT_CORRELATION_LOOKBACK_HOURS=72
INCIDENT_CORRELATION_WINDOW_MINUTES=90
INCIDENT_DEPLOYMENT_WINDOW_MINUTES=120

# Root cause analysis (deterministic scoring; optional Ollama narrative)
RCA_LOOKBACK_HOURS=48
RCA_MAX_LOGS=200
RCA_DEPLOYMENT_WINDOW_MINUTES=180
RCA_WEIGHT_TEMPORAL=12
RCA_WEIGHT_DEPLOYMENT=18
RCA_WEIGHT_SERVICE=20
RCA_WEIGHT_DEPENDENCY=16
RCA_WEIGHT_ERROR_PATTERN=14
RCA_WEIGHT_TRAFFIC=10
RCA_WEIGHT_SEVERITY=10
RCA_CONTRADICTION_PENALTY=15
RCA_OLLAMA_ENABLED=false
RCA_OLLAMA_BASE_URL=http://127.0.0.1:11434
RCA_OLLAMA_MODEL=llama3.2

# Rate limiting (single-process; not distributed)
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_EXPENSIVE_PER_MINUTE=10

# Log storage backend (filesystem for local/dev; s3 reserved for future use)
LOG_STORAGE_BACKEND=filesystem

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000

# Production Compose (optional)
FRONTEND_PORT=8080