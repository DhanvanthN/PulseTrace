# Copy to pulsetrace-prod-qa.env (gitignored). Used ONLY with docker-compose.prod.qa.yml
# Generate JWT: python -c "import secrets; print(secrets.token_hex(32))"

POSTGRES_USER=pulsetrace
POSTGRES_PASSWORD=replace_with_strong_qa_db_password_min_16_chars
POSTGRES_DB=pulsetrace_qa
POSTGRES_PORT=5434
BACKEND_PORT=8001
FRONTEND_PORT=8081

JWT_SECRET_KEY=replace_with_64_char_hex_secret_from_secrets_token_hex_32

# HTTP local QA (set Secure=true when TLS terminates in front of nginx)
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
BACKEND_CORS_ORIGINS=http://127.0.0.1:8081,http://localhost:8081

LOG_LEVEL=INFO
LOG_UPLOAD_MAX_BYTES=10485760